# Rename this file to "secrets.toml" (remove ".example") to use a real database locally,
# OR paste this one line into Streamlit Cloud: App settings -> Secrets.
#
# Get the connection string free from Supabase or Neon (see DEPLOY_GUIDE.md).
# It looks like the line below. Replace it with YOUR string.

DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DBNAME"
